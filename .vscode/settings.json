{
	"editor.formatOnSave": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always"
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.exclude": {
		".svelte-kit": true,
		".vercel": true,
		"build": true,
		"node_modules": true,
		"package-lock.json": true,
		"vite.config.js.timestamp-*": true
	}
}
